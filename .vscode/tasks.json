{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "dependsOn": ["npm: typecheck:watch", "npm: bundle:watch"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "typecheck:watch",
      "label": "npm: typecheck:watch",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "never",
        "group": "watch"
      },
      "problemMatcher": "$tsc-watch"
    },
    {
      "type": "npm",
      "script": "bundle:watch",
      "label": "npm: bundle:watch",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "never",
        "group": "watch"
      },
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "✘ \\[ERROR\\] (.+)",
            "message": 1
          },
          {
            "regexp": "^\\s*(.+):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch.*\\] build started",
          "endsPattern": "^\\[watch.*\\] build finished"
        }
      }
    }
  ]
}
