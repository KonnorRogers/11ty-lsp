{
  "name": "11ty-lsp-root",
  "description": "11ty-lsp monorepo — not published anywhere itself; see vscode/ (the VS Code extension) and server/ (the standalone LSP, published as \"11ty-lsp\" on npm)",
  "author": "Konnor Rogers <konnor5456@gmail.com>",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnorRogers/11ty-lsp"
  },
  "workspaces": [
    "vscode",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc -b -w",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "watch": "concurrently -n tsc,esbuild -c blue,green \"npm run typecheck:watch\" \"npm run bundle:watch\"",
    "start": "npm run watch",
    "test": "npm run test --workspaces --if-present",
    "package-vscode": "npm run typecheck && node esbuild.mjs --production",
    "build": "npm run package-vscode",
    "vscode:package": "npm run package -w vscode",
    "vscode:publish": "npm run publish -w vscode",
    "vscode:version": "npm version --no-git-tag-version -w vscode",
    "server:publish": "npm run typecheck && npm publish -w server",
    "server:version": "npm version --no-git-tag-version -w server"
  },
  "devDependencies": {
    "@11ty/eleventy": "^4.0.0-alpha.10",
    "@awesome.me/buildawesome": "^4.0.0-alpha.10",
    "@types/node": "^20.19.10",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "chokidar": "^3.6.0"
  }
}
