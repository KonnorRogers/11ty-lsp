.vscode/**
.github/**
scratch/**

# Everything is bundled by esbuild into client/dist and server/dist, so raw
# source, tsc's own (unbundled) output, and node_modules don't need to ship
# at all — except `typescript`, which esbuild deliberately leaves external
# (see esbuild.mjs) since it needs its own lib.*.d.ts files on disk.
client/src/**
client/out/**
client/tsconfig.json
client/tsconfig.tsbuildinfo
server/src/**
server/out/**
server/tsconfig.json
server/tsconfig.tsbuildinfo
test-files/**
tsconfig.json
tsconfig.tsbuildinfo
esbuild.mjs
node_modules/**
!node_modules/typescript/**

# npm workspaces symlinks these back to ../client and ../server for module
# resolution; vsce's zip writer can't follow symlinks and crashes on them.
node_modules/11ty-lsp-client
node_modules/11ty-lsp-server

**/*.map
**/.eslintrc*
**/tsconfig.json
.gitignore
**/*.test.js
**/*.test.js.map
